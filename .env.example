# autoCut environment configuration
# Copy to .env and fill in your values.

# --- local-api backend (self-hosted OpenAI-compatible server, e.g. llama.cpp) ---
AUTOCUT_BACKEND=local-api
LOCAL_API_BASE=http://192.168.0.207:8080
LOCAL_API_MODEL=ggml-org_Qwen2.5-VL-7B-Instruct-GGUF_Qwen2.5-VL-7B-Instruct-Q4_K_M.gguf
# LOCAL_API_KEY=not-needed
# LOCAL_API_EMBEDDINGS_MODEL=       # separate model for /v1/embeddings (defaults to LOCAL_API_MODEL)
# EMBED_DIMENSIONS=768

# --- qwen-cloud backend (Alibaba DashScope) ---
# AUTOCUT_BACKEND=qwen-cloud
# DASHSCOPE_API_KEY=your-key
# DASHSCOPE_EMBEDDING_MODEL=qwen3-vl-embedding

# --- gemini backend ---
# AUTOCUT_BACKEND=gemini
# GEMINI_API_KEY=your-key

# --- local backend (local GPU inference via HuggingFace Transformers) ---
# AUTOCUT_BACKEND=local
# AUTOCUT_LOCAL_MODEL=qwen8b
