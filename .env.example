# auto360Cut 設定範本
# 1) 複製一份：cp .env.example .env
# 2) 依照你的 AI 後端填值
# 3) 檢查設定：./scripts/check_setup.sh

# =============================================================================
# 最推薦：local-api（本機或區網內 OpenAI-compatible VLM，例如 llama.cpp server）
# =============================================================================
AUTOCUT_BACKEND=local-api

# 你的 VLM / embedding server。若 server 跑在同一台電腦，通常用 http://127.0.0.1:8080
# 注意：0.0.0.0 常用於「啟動 server 監聽」，client 連線建議填 127.0.0.1 或實際 IP。
LOCAL_API_BASE=http://127.0.0.1:8080
LOCAL_API_MODEL=ggml-org_Qwen2.5-VL-7B-Instruct-GGUF_Qwen2.5-VL-7B-Instruct-Q4_K_M.gguf
#LOCAL_API_KEY=not-needed
#LOCAL_API_EMBEDDINGS_MODEL=your-embedding-model
#EMBED_DIMENSIONS=768

# =============================================================================
# 腳本 / 一鍵剪輯模式使用的文字 LLM（OpenAI-compatible chat completions）
# =============================================================================
# 若你同一個 local-api server 也能做聊天，可維持以下設定。
# 若你用 DeepSeek，請改成下方 DeepSeek 範例。
AUTOCUT_SCRIPT_API_BASE=http://127.0.0.1:8080/v1
AUTOCUT_SCRIPT_API_KEY=not-needed
AUTOCUT_SCRIPT_API_MODEL=your-openai-compatible-llm
#AUTOCUT_SCRIPT_API_MAX_TOKENS=4000

# DeepSeek 範例：
#AUTOCUT_SCRIPT_API_BASE=https://api.deepseek.com/v1
#AUTOCUT_SCRIPT_API_KEY=your-deepseek-api-key
#AUTOCUT_SCRIPT_API_MODEL=deepseek-chat
#AUTOCUT_SCRIPT_API_MODEL=deepseek-reasoner

# =============================================================================
# 雲端 VLM 後端（不用 local-api 時才開）
# =============================================================================
# Gemini：把 AUTOCUT_BACKEND 改成 gemini，並填 GEMINI_API_KEY。
#AUTOCUT_BACKEND=gemini
#GEMINI_API_KEY=your-gemini-api-key

# Qwen Cloud / DashScope：把 AUTOCUT_BACKEND 改成 qwen-cloud，並填 key。
#AUTOCUT_BACKEND=qwen-cloud
#DASHSCOPE_API_KEY=your-dashscope-api-key
#DASHSCOPE_MODEL=qwen-vl-plus

# =============================================================================
# GUI / 影片輸出選項
# =============================================================================
# 詳細日誌預設開啟。想關閉可設 false / 0 / no / off。
#AUTOCUT_VERBOSE=true

# 片頭/片尾字幕卡秒數（預設 3 秒）
#AUTOCUT_CAPTION_DURATION_SECONDS=3

# 片頭/片尾右下角文字與背景色；留空代表不顯示。
#AUTOCUT_BAND_TEXT=Channel Name
#AUTOCUT_BAND_BOX_COLOR=black@1.0

# 背景音樂資料夾；腳本/一鍵模式可自動挑一首。
#AUTOCUT_MUSIC_DIR=/path/to/music-folder
#AUTOCUT_MUSIC_VOLUME=0.18

# CJK 字幕字型檔，遇到中文字型顯示問題時再設定。
#AUTOCUT_OPENING_CAPTION_FONT=/path/to/NotoSansCJK-Regular.ttc
