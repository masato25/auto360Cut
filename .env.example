# auto360Cut environment configuration
# Copy to .env and fill in your values.

# --- local-api backend (self-hosted OpenAI-compatible server, e.g. llama.cpp) ---
AUTOCUT_BACKEND=local-api
LOCAL_API_BASE=http://0.0.0.0:8080
LOCAL_API_MODEL=ggml-org_Qwen2.5-VL-7B-Instruct-GGUF_Qwen2.5-VL-7B-Instruct-Q4_K_M.gguf

# --- openAI or openAI compatible
AUTOCUT_SCRIPT_API_BASE=http://localhost:8080
AUTOCUT_SCRIPT_API_KEY=not-needed
AUTOCUT_SCRIPT_API_MODEL=gpt-5.5
#AUTOCUT_SCRIPT_API_MAX_TOKENS=400000

# --- GUI / script rendering ---
# Detailed logs are enabled by default. Set to false/0/no/off to disable.
#AUTOCUT_VERBOSE=true
# Shared opening/closing caption card duration in seconds (default: 3).
#AUTOCUT_CAPTION_DURATION_SECONDS=3
# Lower-right band text for both opening and closing cards. Leave empty to disable.
#AUTOCUT_BAND_TEXT=Channel Name
# Lower-right band background color for opening/closing cards. FFmpeg drawtext color syntax is accepted.
# Examples: black@1.0, #111111@0.85, blue@0.7
#AUTOCUT_BAND_BOX_COLOR=black@1.0
# Optional background music library. Script/one-click modes can auto-pick a track from here.
#AUTOCUT_MUSIC_DIR=/path/to/music-folder
# Background music volume multiplier mixed under original audio (default: 0.18).
#AUTOCUT_MUSIC_VOLUME=0.18
# Optional font file for CJK captions.
#AUTOCUT_OPENING_CAPTION_FONT=/path/to/NotoSansCJK-Regular.ttc
