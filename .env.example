# auto360Cut environment configuration
# Copy to .env and fill in your values.
#
# Supported hybrid modes:
#   1) llama.cpp/local-api local VLM indexing/search + your self-hosted OpenAI-compatible script LLM
#      Set AUTOCUT_BACKEND=local-api and configure LOCAL_API_* plus AUTOCUT_SCRIPT_API_*.
#   2) Gemini VLM indexing/search + DeepSeek script LLM
#      Set AUTOCUT_BACKEND=gemini and configure GEMINI_API_KEY plus AUTOCUT_SCRIPT_API_*.

# ---------------------------------------------------------------------------
# Mode 1: llama.cpp/local-api local VLM + self-hosted OpenAI-compatible LLM
# LOCAL_API_* is your local VLM/embeddings server (for example llama.cpp).
# AUTOCUT_SCRIPT_API_* is your own OpenAI-compatible chat endpoint for script writing.
# Used by autocut.py and by autocut_script.py for indexing/search/captions.
# ---------------------------------------------------------------------------
AUTOCUT_BACKEND=local-api
LOCAL_API_BASE=http://0.0.0.0:8080
LOCAL_API_MODEL=ggml-org_Qwen2.5-VL-7B-Instruct-GGUF_Qwen2.5-VL-7B-Instruct-Q4_K_M.gguf
# Optional: use a separate text embedding model exposed by the same server.
#LOCAL_API_EMBEDDINGS_MODEL=your-embedding-model
#LOCAL_API_KEY=not-needed
#EMBED_DIMENSIONS=768

# ---------------------------------------------------------------------------
# Mode 2: Gemini VLM backend
# To use this mode, change AUTOCUT_BACKEND above to gemini and set the key.
# LOCAL_API_MODEL is ignored by script mode when AUTOCUT_BACKEND=gemini.
# ---------------------------------------------------------------------------
#AUTOCUT_BACKEND=gemini
#GEMINI_API_KEY=your-gemini-api-key

# ---------------------------------------------------------------------------
# Script LLM: your self-hosted OpenAI-compatible chat API (mode 1)
# or DeepSeek OpenAI-compatible chat API (mode 2).
# Used only by autocut_script.py create to write the edit script.
# For mode 1, replace these with your own endpoint/model/key if needed.
# For mode 2 DeepSeek endpoint: https://api.deepseek.com/v1
# ---------------------------------------------------------------------------
AUTOCUT_SCRIPT_API_BASE=http://0.0.0.0:8080/v1
AUTOCUT_SCRIPT_API_KEY=not-needed
AUTOCUT_SCRIPT_API_MODEL=your-openai-compatible-llm
# Mode 2 DeepSeek example:
#AUTOCUT_SCRIPT_API_BASE=https://api.deepseek.com/v1
#AUTOCUT_SCRIPT_API_KEY=your-deepseek-api-key
#AUTOCUT_SCRIPT_API_MODEL=deepseek-chat
# Optional: for DeepSeek reasoning model, use deepseek-reasoner.
#AUTOCUT_SCRIPT_API_MODEL=deepseek-reasoner
# Optional output cap; leave unset for provider/model default.
#AUTOCUT_SCRIPT_API_MAX_TOKENS=4000

# --- GUI / script rendering ---
# Detailed logs are enabled by default. Set to false/0/no/off to disable.
#AUTOCUT_VERBOSE=true
# Shared opening/closing caption card duration in seconds (default: 3).
#AUTOCUT_CAPTION_DURATION_SECONDS=3
# Lower-right band text for both opening and closing cards. Leave empty to disable.
#AUTOCUT_BAND_TEXT=Channel Name
# Lower-right band background color for opening/closing cards. FFmpeg drawtext color syntax is accepted.
# Examples: black@1.0, #111111@0.85, blue@0.7
#AUTOCUT_BAND_BOX_COLOR=black@1.0
# Optional background music library. Script/one-click modes can auto-pick a track from here.
#AUTOCUT_MUSIC_DIR=/path/to/music-folder
# Background music volume multiplier mixed under original audio (default: 0.18).
#AUTOCUT_MUSIC_VOLUME=0.18
# Optional font file for CJK captions.
#AUTOCUT_OPENING_CAPTION_FONT=/path/to/NotoSansCJK-Regular.ttc
